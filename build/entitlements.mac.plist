<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for JIT compilation (e.g., V8 in Electron) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required for unsigned executable memory (some Electron internals) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Outbound network access (connecting to Appium servers) -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Read/write files the user selects (for .appiumsession files) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>